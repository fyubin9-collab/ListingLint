{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listinglint.dev/schema/rule-pack-v1.json",
  "title": "ListingLint Rule Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "fieldAliases", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": { "type": "string", "maxLength": 300 },
    "fieldAliases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku": { "$ref": "#/$defs/aliases" },
        "title": { "$ref": "#/$defs/aliases" },
        "price": { "$ref": "#/$defs/aliases" },
        "currency": { "$ref": "#/$defs/aliases" },
        "stock": { "$ref": "#/$defs/aliases" },
        "brand": { "$ref": "#/$defs/aliases" },
        "category": { "$ref": "#/$defs/aliases" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/requiredRule" },
          { "$ref": "#/$defs/uniqueRule" },
          { "$ref": "#/$defs/lengthRule" },
          { "$ref": "#/$defs/numberRule" },
          { "$ref": "#/$defs/patternRule" },
          { "$ref": "#/$defs/forbiddenTermsRule" },
          { "$ref": "#/$defs/enumRule" },
          { "$ref": "#/$defs/imageRule" }
        ]
      }
    }
  },
  "$defs": {
    "field": { "enum": ["sku", "title", "price", "currency", "stock", "brand", "category"] },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "severity": { "enum": ["error", "warning"], "default": "error" },
    "baseProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string", "maxLength": 200 },
        "suggestion": { "type": "string", "maxLength": 300 }
      }
    },
    "requiredRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "field", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "required" }, "field": { "$ref": "#/$defs/field" },
        "severity": { "$ref": "#/$defs/severity" }, "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "uniqueRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "unique" }, "field": { "$ref": "#/$defs/field" },
        "severity": { "$ref": "#/$defs/severity" }, "caseSensitive": { "type": "boolean" },
        "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "lengthRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "severity"],
      "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "length" }, "field": { "$ref": "#/$defs/field" },
        "severity": { "$ref": "#/$defs/severity" }, "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }, "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "numberRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "number" }, "field": { "$ref": "#/$defs/field" },
        "severity": { "$ref": "#/$defs/severity" }, "min": { "type": "number" }, "max": { "type": "number" },
        "integer": { "type": "boolean" }, "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "patternRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "pattern", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "pattern" }, "field": { "$ref": "#/$defs/field" },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 }, "flags": { "type": "string", "pattern": "^[imu]*$" },
        "severity": { "$ref": "#/$defs/severity" }, "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "forbiddenTermsRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "fields", "terms", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "forbiddenTerms" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
        "terms": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "caseSensitive": { "type": "boolean" }, "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "enumRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "values", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "enum" }, "field": { "$ref": "#/$defs/field" },
        "values": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string" } },
        "caseSensitive": { "type": "boolean" }, "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    },
    "imageRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "severity"],
      "properties": {
        "id": { "type": "string" }, "type": { "const": "image" }, "severity": { "$ref": "#/$defs/severity" },
        "minCount": { "type": "integer", "minimum": 0 },
        "allowedExtensions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9]+$" } },
        "maxBytes": { "type": "integer", "minimum": 1 }, "minWidth": { "type": "integer", "minimum": 1 },
        "minHeight": { "type": "integer", "minimum": 1 }, "message": { "type": "string" }, "suggestion": { "type": "string" }
      }
    }
  }
}
